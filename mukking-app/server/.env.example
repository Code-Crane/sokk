PORT=4000
AUTH_PROVIDER=signed_mock
REPOSITORY_PROVIDER=memory
# REPOSITORY_PROVIDER=supabase

# Optional restaurant/favorite write limiter. Defaults: 30 writes / 60 seconds.
# RATE_LIMIT_RESTAURANT_WRITE_MAX=30
# RATE_LIMIT_RESTAURANT_WRITE_WINDOW_MS=60000
AUTH_JWT_SECRET=replace-with-long-random-dev-secret
AUTH_JWT_EXPIRES_IN_SECONDS=604800

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key-never-expose-to-client

# Server-only Kakao Local REST API key. Never expose this to Flutter or admin clients.
KAKAO_REST_API_KEY=

# Push delivery is disabled by default. Use mock for local smoke tests.
PUSH_PROVIDER=noop
# PUSH_PROVIDER=mock
# PUSH_PROVIDER=fcm

# Preferred in hosted environments: Application Default Credentials.
FIREBASE_USE_ADC=false
# GOOGLE_APPLICATION_CREDENTIALS=C:\\path\\to\\server-only-service-account.json

# Optional server-only alternative to Application Default Credentials.
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_CLIENT_EMAIL=your-firebase-service-account@example.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY=replace-with-server-only-private-key

ADMIN_UID_WHITELIST=00000000-0000-0000-0000-000000000000
ADMIN_EMAIL_WHITELIST=owner@example.com
ADMIN_REQUIRE_MFA=true

CORS_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:8081,http://localhost:19006

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_AUTH_SIGNUP_MAX=30
RATE_LIMIT_AUTH_LOGIN_MAX=30
RATE_LIMIT_VERIFICATION_MAX=60
RATE_LIMIT_MATCHING_REQUEST_MAX=20
RATE_LIMIT_REPORT_CREATE_MAX=10
RATE_LIMIT_BLOCK_CREATE_MAX=20
RATE_LIMIT_RESTAURANT_DISCOVERY_MAX=10
# RATE_LIMIT_RESTAURANT_DISCOVERY_WINDOW_MS=60000
RATE_LIMIT_PUSH_DEVICE_MAX=30
RATE_LIMIT_ADMIN_AUTH_MAX=60
RATE_LIMIT_ADMIN_SENSITIVE_MAX=20
